# OpenAI API key used server-side only (app/api/image-gen/*), consumed by
# useImageAgent through /api/image-gen/generate. Never expose this with a
# NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# Higgsfield API credentials used server-side only (app/api/video-gen/*).
# video-gen exploration is currently paused in favor of image-gen; kept
# here so that feature can resume later without re-deriving config.
# Never expose these with a NEXT_PUBLIC_ prefix.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://platform.higgsfield.ai
